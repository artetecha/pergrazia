{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"slug": "section-ink",
	"title": "Ink section",
	"blockTypes": [
		"core/group",
		"core/columns",
		"core/column"
	],
	"styles": {
		"color": {
			"background": "var:preset|color|contrast",
			"text": "var:preset|color|base"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var:preset|color|base"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|accent-3"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|base"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|base",
					"text": "var:preset|color|contrast"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|accent-3",
						"text": "var:preset|color|contrast"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|base"
						}
					}
				}
			},
			"core/navigation": {
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|base"
						}
					}
				}
			},
			"core/site-tagline": {
				"color": {
					"text": "var:preset|color|accent-3"
				}
			},
			"core/separator": {
				"color": {
					"text": "rgb(255 255 255 / 0.18)"
				}
			}
		}
	}
}
