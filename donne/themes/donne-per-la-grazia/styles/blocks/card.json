{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"slug": "card",
	"title": "Card",
	"blockTypes": [ "core/group" ],
	"styles": {
		"color": { "background": "var:preset|color|base" },
		"border": { "color": "var:preset|color|line", "radius": "1.25rem", "style": "solid", "width": "1px" },
		"spacing": {
			"padding": { "top": "var:preset|spacing|50", "right": "var:preset|spacing|50", "bottom": "var:preset|spacing|50", "left": "var:preset|spacing|50" }
		}
	}
}
