{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"slug": "eyebrow",
	"title": "Eyebrow",
	"blockTypes": [ "core/paragraph", "core/heading" ],
	"styles": {
		"color": { "text": "var:preset|color|accent" },
		"typography": {
			"fontFamily": "var:preset|font-family|sans",
			"fontSize": "var:preset|font-size|x-small",
			"fontStyle": "normal",
			"fontWeight": "600",
			"letterSpacing": "0.14em",
			"lineHeight": "1.4",
			"textTransform": "uppercase"
		}
	}
}
