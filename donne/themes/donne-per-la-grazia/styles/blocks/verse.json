{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"slug": "verse",
	"title": "Scripture",
	"blockTypes": [ "core/quote" ],
	"styles": {
		"border": {
			"top": { "width": "0", "style": "none" },
			"right": { "width": "0", "style": "none" },
			"bottom": { "width": "0", "style": "none" },
			"left": { "width": "0", "style": "none" }
		},
		"spacing": {
			"padding": { "top": "var:preset|spacing|50", "right": "var:preset|spacing|50", "bottom": "var:preset|spacing|50", "left": "var:preset|spacing|50" }
		},
		"typography": { "fontSize": "var:preset|font-size|x-large", "lineHeight": "1.3" },
		"css": "& { text-align: center; } &::before { content: \"\"; display: block; width: 2.5rem; height: 1px; margin: 0 auto 1.5rem; background: var(--wp--preset--color--accent); } & cite { display: block; margin-top: 1.25rem; color: var(--wp--preset--color--accent); }"
	}
}
