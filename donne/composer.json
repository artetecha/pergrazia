{
  "name": "artetecha/donne-per-la-grazia",
  "description": "Composer-managed WordPress project for donne.pergrazia.com on Upsun.",
  "keywords": [
    "upsun",
    "wordpress"
  ],
  "type": "project",
  "license": "GPL-2.0-or-later",
  "homepage": "https://donne.pergrazia.com/",
  "authors": [
    {
      "name": "ArteTecha",
      "homepage": "https://artetecha.com/"
    }
  ],
  "repositories": [
    {
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    }
  ],
  "require": {
    "php": ">=8.4",
    "artetecha/upsun-wp": "^1.0",
    "composer/installers": "^2.3",
    "inpsyde/wp-translation-downloader": "^2.0",
    "platformsh/config-reader": "^3.0",
    "roots/wordpress": "~7.1.2",
    "wpackagist-plugin/akismet": "^5.0",
    "wpackagist-plugin/redis-cache": "^3.0"
  },
  "extra": {
    "wordpress-install-dir": "wordpress",
    "installer-paths": {
      "composer-mu-plugins/{$name}": [
        "artetecha/upsun-wp"
      ],
      "wordpress/wp-content/plugins/{$name}": [
        "type:wordpress-plugin"
      ],
      "wordpress/wp-content/themes/{$name}": [
        "type:wordpress-theme"
      ],
      "wordpress/wp-content/mu-plugins/{$name}": [
        "type:wordpress-muplugin"
      ]
    },
    "distro": {
      "default-theme": "donne-per-la-grazia",
      "enable-plugins": [
        "akismet",
        "redis-cache"
      ]
    },
    "wp-translation-downloader": {
      "languages": [
        "it_IT"
      ],
      "directory": "wordpress/wp-content/languages"
    }
  },
  "scripts": {
    "postbuild": [
      "test -f wordpress/wp-includes/version.php",
      "cp wp-config.php wordpress/",
      "cp -R mu-plugins wordpress/wp-content/",
      "rm -rf wordpress/wp-content/mu-plugins/upsun",
      "cp -R composer-mu-plugins/upsun wordpress/wp-content/mu-plugins/upsun",
      "cp composer-mu-plugins/upsun/upsun-loader.php wordpress/wp-content/mu-plugins/upsun-loader.php",
      "cp wordpress/wp-content/plugins/redis-cache/includes/object-cache.php wordpress/wp-content/object-cache.php",
      "rm -rf wordpress/wp-content/themes/donne-per-la-grazia",
      "mkdir -p wordpress/wp-content/themes",
      "cp -R themes/donne-per-la-grazia wordpress/wp-content/themes/donne-per-la-grazia"
    ],
    "post-install-cmd": "@postbuild",
    "post-update-cmd": "@postbuild"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "inpsyde/wp-translation-downloader": true,
      "roots/wordpress-core-installer": true
    },
    "platform": {
      "php": "8.4.0"
    },
    "sort-packages": true
  }
}
